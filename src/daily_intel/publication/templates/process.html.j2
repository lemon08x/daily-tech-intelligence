<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <style>
    :root { --bg:#f4f6f8; --panel:#fff; --ink:#1b2433; --muted:#667085; --line:#e4e8ef; --brand:#2455b8; --up:#c63f3a; --amber:#9a5b00; }
    * { box-sizing:border-box; }
    body { margin:0; color:var(--ink); background:var(--bg); font:15px/1.65 "Segoe UI","Microsoft YaHei",sans-serif; }
    a { color:var(--brand); }
    main { width:min(1100px, calc(100% - 32px)); margin:24px auto 64px; }
    header, section { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:22px 24px; }
    header { color:#fff; background:linear-gradient(135deg,#12204a,#315fc7); }
    header .muted { color:#dbe5ff; }
    h1 { margin:0 0 8px; font-size:26px; }
    h2 { margin:0 0 12px; font-size:19px; }
    p { margin:6px 0; }
    .muted { color:var(--muted); }
    nav { display:flex; flex-wrap:wrap; gap:8px; margin:16px 0; }
    nav a { padding:6px 10px; border:1px solid var(--line); border-radius:999px; background:#fff; text-decoration:none; font-size:13px; }
    section { margin-top:14px; }
    table { width:100%; border-collapse:collapse; font-size:13px; }
    th { text-align:left; color:var(--muted); background:#f8fafc; font-size:12px; }
    th, td { padding:8px 7px; border-bottom:1px solid var(--line); vertical-align:top; }
    .table-wrap { overflow:auto; }
    .chip { display:inline-block; margin:0 6px 6px 0; padding:3px 8px; border-radius:999px; background:#edf3ff; color:#22449e; font-size:12px; font-weight:700; }
    .stale, .warn { color:var(--amber); font-weight:700; }
    .fail { color:var(--up); font-weight:700; }
    details { margin-top:8px; }
    summary { cursor:pointer; color:var(--brand); font-weight:700; }
    .mono { font-family:Consolas,monospace; font-size:12px; }
    footer { padding:18px 4px; color:var(--muted); }
  </style>
</head>
<body>
<main>
  <header>
    <h1>{{ title }}</h1>
    <p class="muted">{{ report_date }} · 实验 {{ experiment_id }} · 运行 {{ run_name }} · {{ generated_at }} · {{ ai_status_label }}</p>
    <p>这份页面记录本次从信源采集到成稿的处理过程，方便对照漏选、降级和过滤规则。它不是对外日报。</p>
  </header>
  <nav>
    <a href="daily_digest.html">返回日报</a>
    <a href="#overview">概况</a>
    <a href="#market">市场</a>
    <a href="#collect">采集</a>
    <a href="#cluster">聚类</a>
    <a href="#select">选题</a>
    <a href="#research">深研</a>
    <a href="#git">Git</a>
    <a href="#brief">速读</a>
    <a href="#publish">发布</a>
  </nav>

  <section id="overview">
    <h2>1. 运行概况</h2>
    <p>提示词 {{ prompt_version or '—' }} · 质量策略 {{ quality.policy_version or '—' }} · 缓存作用域 <span class="mono">{{ cache_scope or '—' }}</span></p>
    <p>模型提供方 {{ model_runtime.provider or 'unknown' }}{% if model_runtime.models %} · 实际模型 {% for stage, model in model_runtime.models.items() %}{{ stage }}={{ model }}{% if not loop.last %}、{% endif %}{% endfor %}{% endif %}</p>
    <p>调用 {{ usage.calls or 0 }} 次，输入 {{ usage.input_tokens or 0 }} tokens，输出 {{ usage.output_tokens or 0 }} tokens{% if usage.estimated %}（估算）{% endif %}。缓存命中 {{ cache.hits or 0 }}，未命中 {{ cache.misses or 0 }}{% if cache.forced %}，本次强制重算{% endif %}。</p>
    <p>质量：平均 {{ quality.average_score or 0 }} · 通过 {{ quality.passed or 0 }} · 降级 {{ quality.downgraded or 0 }}。栏位上限 泛读 {{ limits.max_general or '—' }} / 硬核 {{ limits.max_hardcore or '—' }} / 合计 {{ limits.max_deep or '—' }}。</p>
    <p>
      <span class="chip">文档 {{ documents|length }}</span>
      <span class="chip">事件 {{ events|length }}</span>
      <span class="chip">发布 {{ published|length }}</span>
      <span class="chip">Git {{ github_projects|length }}</span>
      <span class="chip">错误 {{ errors|length }}</span>
    </p>
    {% if errors %}<ul>{% for item in errors %}<li class="fail">{{ item }}</li>{% endfor %}</ul>{% endif %}
  </section>

  <section id="market">
    <h2>2. 市场采集与筛选</h2>
    <p>快照 {{ market.snapshot_rows or 0 }} 行，规则筛选后 {{ market.eligible_rows or 0 }} 行。新闻入库 {{ market.news_in or 0 }} 条，入选 {{ market.news_selected|length }} 条，未入选 {{ market.news_dropped_count or market.news_dropped|length }} 条。</p>
    {% if market_sources %}
    <h3>数据源</h3>
    <div class="table-wrap"><table><thead><tr><th>源</th><th>状态</th><th>说明</th></tr></thead><tbody>
      {% for item in market_sources %}<tr><td>{{ item.name }}</td><td class="{{ 'stale' if item.stale else '' }}">{{ '缓存/降级' if item.stale else '实时成功' }}</td><td class="muted">{{ item.source }}{% if item.error %} · {{ item.error }}{% endif %}</td></tr>{% endfor %}
    </tbody></table></div>
    {% endif %}
    {% if market.industry_bars %}
    <p>产业涨跌前三后三：{% for item in market.industry_bars %}<span class="chip">{{ item.name }} {{ item.label }}</span>{% endfor %}</p>
    {% endif %}
    {% if market.board %}
    <p>全球涨跌前三后三：{% for item in market.board %}<span class="chip">{{ item.label }} {{ item.label_change }}</span>{% endfor %}</p>
    {% endif %}
    {% if market.news_selected %}
    <details open><summary>入选市场新闻</summary>
      <div class="table-wrap"><table><thead><tr><th>标题</th><th>影响/后果摘要</th></tr></thead><tbody>
        {% for item in market.news_selected %}<tr><td>{% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}<div class="muted">{{ item.summary }}</div></td><td>{{ item.impact }}{% if item.consequences %}<div class="muted">{{ item.consequences }}</div>{% endif %}</td></tr>{% endfor %}
      </tbody></table></div>
    </details>
    {% endif %}
    {% if market.news_dropped %}
    <details><summary>未入选市场新闻（最多 50 条）</summary>
      <div class="table-wrap"><table><thead><tr><th>标题</th><th>原因</th></tr></thead><tbody>
        {% for item in market.news_dropped %}<tr><td>{{ item.title }}</td><td>{{ item.reason }}</td></tr>{% endfor %}
      </tbody></table></div>
    </details>
    {% endif %}
  </section>

  <section id="collect">
    <h2>3. 科技来源采集</h2>
    {% if intelligence_sources %}
    <div class="table-wrap"><table><thead><tr><th>来源</th><th>状态</th><th>条数</th><th>错误</th></tr></thead><tbody>
      {% for item in intelligence_sources %}<tr><td>{{ item.source or item.name }}</td><td class="{{ 'stale' if item.stale else '' }}">{{ '失败/缓存' if item.stale else '采集成功' }}</td><td>{{ item.count or 0 }}</td><td class="muted">{{ item.error }}</td></tr>{% endfor %}
    </tbody></table></div>
    {% endif %}
    {% if documents %}
    <details><summary>入库文档 {{ documents|length }} 篇</summary>
      <div class="table-wrap"><table><thead><tr><th>来源</th><th>层级</th><th>类型</th><th>标题</th></tr></thead><tbody>
        {% for item in documents %}<tr><td>{{ item.source_name }}</td><td>{{ item.tier }}</td><td>{{ item.content_type }}{% if item.lane %} / {{ item.lane }}{% endif %}</td><td>{% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</td></tr>{% endfor %}
      </tbody></table></div>
    </details>
    {% endif %}
  </section>

  <section id="cluster">
    <h2>4. 聚类成事件</h2>
    <p>72 小时窗口内聚成 {{ events|length }} 个候选事件，再交给选题。</p>
    {% if events %}
    <div class="table-wrap"><table><thead><tr><th>事件</th><th>主题</th><th>栏</th><th>确定性分</th><th>文档</th></tr></thead><tbody>
      {% for item in events %}<tr><td>{{ item.title }}</td><td>{{ item.topic }}</td><td>{{ item.lane }}</td><td>{{ item.deterministic_score }}</td><td class="muted">{{ item.sources|join('、') }}</td></tr>{% endfor %}
    </tbody></table></div>
    {% endif %}
  </section>

  <section id="select">
    <h2>5. 选题：Scout、融合分、次日降权</h2>
    <p>Scout 可剔除低相关事件。留下的事件按确定性分 65% + 模型分 35% 排序，昨天已发布的会乘以降权系数。</p>
    {% if selection %}
    <div class="table-wrap"><table><thead><tr><th>#</th><th>事件</th><th>处置</th><th>分</th><th>降权</th><th>说明</th></tr></thead><tbody>
      {% for item in selection %}<tr><td>{{ item.rank or '' }}</td><td>{{ item.title }}<div class="muted">{{ item.lane }} · {{ item.topic }}</div></td><td>{{ item.action_label }}</td><td>{{ item.score if item.score is not none else item.deterministic_score }}</td><td>{{ item.repeat_factor if item.repeat_factor is not none else '' }}</td><td class="muted">{{ item.reason }}</td></tr>{% endfor %}
    </tbody></table></div>
    {% else %}<p class="muted">本次没有留下选题明细，可能是离线或注入了测试工作流。</p>{% endif %}
  </section>

  <section id="research">
    <h2>6. 深研与质量门</h2>
    <p>按泛读/硬核栏位上限取事件。质量门检查证据、事实条数和 unsupported_claims；不通过则降为线索。</p>
    {% if research %}
    <div class="table-wrap"><table><thead><tr><th>事件</th><th>处置</th><th>状态</th><th>质量</th><th>问题</th></tr></thead><tbody>
      {% for item in research %}<tr><td>{{ item.headline or item.title }}<div class="muted">{{ item.lane }} · {{ item.sources|join('、') if item.sources else '' }}</div></td><td>{{ item.decision_label }}</td><td>{{ item.status or '—' }}</td><td>{% if item.quality_score is not none %}{{ item.quality_score }}{% if item.quality_passed %} 通过{% else %} 降级{% endif %}{% else %}—{% endif %}</td><td class="{{ 'warn' if item.issues else 'muted' }}">{% if item.issues %}{{ item.issues|join('、') }}{% elif item.reason %}{{ item.reason }}{% else %}—{% endif %}</td></tr>{% endfor %}
    </tbody></table></div>
    {% endif %}
  </section>

  <section id="git">
    <h2>7. Git / 开源目录</h2>
    {% if github_sources %}
    <div class="table-wrap"><table><thead><tr><th>源</th><th>状态</th><th>条数</th><th>错误</th></tr></thead><tbody>
      {% for item in github_sources %}<tr><td>{{ item.source or item.name }}</td><td class="{{ 'stale' if item.stale else '' }}">{{ '失败/缓存' if item.stale else '采集成功' }}</td><td>{{ item.count or 0 }}</td><td class="muted">{{ item.error }}</td></tr>{% endfor %}
    </tbody></table></div>
    {% endif %}
    {% if github_projects %}
    <ul>{% for item in github_projects %}<li><strong>{{ item.origin or 'GitHub' }}</strong> · {% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.full_name }}</a>{% else %}{{ item.full_name }}{% endif %} · {{ item.reason }}{% if item.plain %}<div class="muted">{{ item.plain }}</div>{% endif %}</li>{% endfor %}</ul>
    {% else %}<p class="muted">没有开源项目入选。</p>{% endif %}
  </section>

  <section id="brief">
    <h2>8. 今日速读与市场新闻分析</h2>
    <p>速读来源：{{ '模型 digest_brief' if briefing.source == 'model' else '程序回退拼接' }}{% if briefing.errors %} · {{ briefing.errors|join('；') }}{% endif %}</p>
    {% if briefing.scan_paragraph %}<p>{{ briefing.scan_paragraph }}</p>{% else %}<p class="muted">没有生成速读段落。</p>{% endif %}
  </section>

  <section id="publish">
    <h2>9. 最终发布条目</h2>
    {% if published %}
    <div class="table-wrap"><table><thead><tr><th>栏</th><th>标题</th><th>状态</th><th>质量</th></tr></thead><tbody>
      {% for item in published %}<tr><td>{{ item.lane }}</td><td>{% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.headline }}</a>{% else %}{{ item.headline }}{% endif %}</td><td>{{ item.status }}</td><td>{{ item.quality_score }}{% if item.issues %} · {{ item.issues|join('、') }}{% endif %}</td></tr>{% endfor %}
    </tbody></table></div>
    {% else %}<p class="muted">没有可发布的科技分析。</p>{% endif %}
    <p class="muted">同目录还有 daily_digest.html、intelligence.json、run_meta.json 和 process.json。</p>
  </section>

  <footer>处理过程仅用于改进流水线，不构成投资建议。</footer>
</main>
</body>
</html>
