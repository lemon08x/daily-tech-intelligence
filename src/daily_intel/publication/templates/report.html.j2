<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <style>
    :root {
      --bg:#f2f4f7; --panel:#fff; --ink:#18202f; --muted:#697386;
      --line:#e3e7ee; --brand:#2455b8; --brand-soft:#edf3ff;
      --down:#117a57; --amber:#9a5b00;
    }
    * { box-sizing:border-box; }
    [hidden] { display:none !important; }
    html { scroll-behavior:smooth; }
    body { margin:0; color:var(--ink); background:var(--bg); font:15px/1.75 "Segoe UI","Microsoft YaHei",sans-serif; }
    a { color:var(--brand); text-decoration:none; }
    a:hover { text-decoration:underline; }
    main { width:min(1000px,calc(100% - 32px)); margin:26px auto 64px; }
    header { padding:30px 34px; border-radius:18px; color:#fff; background:linear-gradient(135deg,#12204a,#315fc7); box-shadow:0 16px 40px #203b8028; }
    h1 { margin:0 0 8px; font-size:30px; line-height:1.3; }
    h2 { margin:0 0 18px; font-size:22px; line-height:1.45; }
    h3 { margin:0 0 9px; font-size:19px; line-height:1.45; }
    p { margin:7px 0; }
    ul { padding-left:22px; }
    .muted { color:var(--muted); }
    header .muted { color:#dbe5ff; }
    .report-tabs { display:flex; gap:8px; margin:18px 0 0; padding:6px; border:1px solid var(--line); border-radius:14px; background:#fff; box-shadow:0 4px 18px #1720330a; }
    .report-tabs button { flex:1; min-height:44px; border:0; border-radius:10px; color:#596275; background:transparent; font:inherit; font-weight:750; cursor:pointer; }
    .report-tabs button[aria-selected="true"] { color:#fff; background:var(--brand); box-shadow:0 5px 14px #2446a42e; }
    .report-tabs button:focus-visible { outline:3px solid #91adf3; outline-offset:2px; }
    .sub-tabs { margin:16px 0 0; }
    .sub-tabs button { min-height:38px; font-size:14px; }
    .tab-panel { margin-top:16px; }
    .lane-panel { margin-top:0; }
    .section,.story { background:var(--panel); border:1px solid var(--line); border-radius:14px; box-shadow:0 4px 18px #1720330a; }
    .section { padding:24px; margin-top:16px; overflow:hidden; }
    .section-intro { max-width:760px; margin-top:-10px; }
    .digest { border-left:4px solid var(--brand); }
    .digest-block { margin-top:14px; }
    .digest-block:first-of-type { margin-top:0; }
    .digest-block h3 { font-size:16px; margin-bottom:8px; }
    .scan-list { display:flex; flex-direction:column; gap:8px; }
    .scan-item { display:flex; align-items:flex-start; gap:8px; padding:4px 0; line-height:1.5; }
    .scan-kicker { flex:none; min-width:3.2em; padding:1px 8px; border-radius:999px; color:#22449e; background:var(--brand-soft); font-size:12px; font-weight:750; text-align:center; }
    .scan-item a { color:var(--ink); font-weight:650; }
    .scan-clusters { columns:2; column-gap:14px; margin-top:18px; }
    .scan-cluster { display:inline-block; width:100%; margin:0 0 14px; padding:17px 18px; break-inside:avoid; border:1px solid var(--line); border-radius:12px; background:#fbfcfe; }
    .scan-cluster h3 { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; font-size:16px; }
    .scan-count { color:var(--muted); font-size:12px; font-weight:500; }
    .scan-cluster .scan-item { flex-direction:column; gap:2px; padding:10px 0 10px 15px; border-top:1px solid #edf0f5; position:relative; }
    .scan-cluster .scan-item:first-child { border-top:0; }
    .scan-cluster .scan-item::before { content:""; position:absolute; top:15px; left:1px; width:5px; height:5px; border-radius:50%; background:#8fa7dc; }
    .extensive-entry { width:100%; padding:0; border:0; color:var(--ink); background:transparent; font:inherit; font-weight:650; line-height:1.5; text-align:left; cursor:pointer; }
    .extensive-entry:hover { color:var(--brand); text-decoration:underline; }
    .extensive-entry:focus-visible,.extensive-back:focus-visible { outline:3px solid #91adf3; outline-offset:3px; border-radius:4px; }
    .extensive-detail { border-left:4px solid var(--brand); }
    .extensive-back { margin:0 0 18px; padding:0; border:0; color:var(--brand); background:transparent; font:inherit; font-weight:750; cursor:pointer; }
    .extensive-detail h2 { margin-bottom:8px; }
    .extensive-detail-meta { margin-bottom:14px; }
    .extensive-detail-block { margin-top:20px; }
    .extensive-detail-block h3 { margin-bottom:8px; font-size:16px; }
    .takeaway { margin:8px 0 10px; font-size:16px; line-height:1.7; }
    .story { padding:26px 28px; margin:14px 0; }
    .story-kicker { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:7px; color:var(--muted); font-size:13px; font-weight:700; letter-spacing:.02em; }
    .story-title a { color:var(--ink); }
    .story-title a::after { content:" ↗"; color:var(--brand); font-size:.8em; }
    .badge { flex:none; padding:3px 10px; border-radius:999px; color:#22449e; background:var(--brand-soft); font-size:12px; font-weight:750; }
    .badge.lead { color:var(--amber); background:#fff2d8; }
    .quality-line { font-size:13px; }
    .highlights { margin:16px 0; padding:14px 18px 14px 36px; border-left:4px solid #9bb5ef; border-radius:0 9px 9px 0; background:#f7f9fd; }
    .highlights li { margin:4px 0; }
    .story-actions { display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-top:14px; }
    .source-link { display:inline-flex; align-items:center; min-height:38px; padding:6px 13px; border:1px solid #b8c8ee; border-radius:9px; background:#f7f9ff; font-weight:750; }
    details.deep-dive { margin-top:14px; border-top:1px solid var(--line); }
    details.deep-dive > summary { padding:14px 2px 2px; color:var(--brand); font-weight:750; cursor:pointer; list-style:none; }
    details.deep-dive > summary::-webkit-details-marker { display:none; }
    details.deep-dive > summary::before { content:"＋"; display:inline-block; width:20px; }
    details.deep-dive[open] > summary::before { content:"－"; }
    .deep-body { padding-top:8px; }
    .analysis-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px 24px; margin:12px 0; }
    .analysis-grid > div { padding-left:12px; border-left:3px solid #dbe4ff; }
    .subhead { margin:18px 0 8px; font-weight:800; }
    .evidence,.quality-alert { padding:10px 12px; margin:8px 0; color:#39445b; background:#f7f9fc; border-radius:8px; }
    .reader-summary { margin:16px 0; padding:2px 18px; border-left:3px solid #b9cdf6; }
    .reader-summary p { margin:10px 0; line-height:1.9; }
    .reader-label { margin:16px 0 6px; font-size:13px; color:var(--muted); font-weight:700; }
    .scan-context { margin:5px 0 0; color:#465269; font-size:14px; }
    .quality-alert { color:#744700; background:#fff6e5; }
    .runtime summary { cursor:pointer; font-size:18px; font-weight:800; }
    .down { color:var(--down); }
    .status { display:flex; justify-content:space-between; gap:10px; padding:9px 0; border-bottom:1px solid var(--line); display:grid; grid-template-columns:1.1fr .8fr 1.5fr; }
    .stale { color:var(--amber); font-weight:750; }
    footer { padding:20px 4px; color:var(--muted); }
    @media (max-width:800px) {
      .analysis-grid { grid-template-columns:1fr 1fr; }
      .scan-clusters { columns:1; }
      .status { grid-template-columns:1fr; }
    }
    @media (max-width:560px) {
      body { font-size:14px; }
      main { width:calc(100% - 18px); margin-top:10px; }
      header,.section,.story { padding:18px; }
      h1 { font-size:25px; }
      .analysis-grid { grid-template-columns:1fr; }
      .report-tabs { position:sticky; top:0; z-index:5; }
      .story-kicker { align-items:flex-start; }
    }
    @media print {
      body { background:#fff; }
      main { width:100%; margin:0; }
      header { color:#111; background:#fff; box-shadow:none; border:1px solid var(--line); }
      header .muted { color:var(--muted); }
      .report-tabs { display:none; }
      .tab-panel[hidden] { display:block !important; }
      .extensive-detail[hidden] { display:block !important; }
      .extensive-back { display:none; }
      details:not([open]) > *:not(summary) { display:block; }
      .section,.story { break-inside:avoid; box-shadow:none; }
    }
  </style>
</head>
<body>
<main>
  <header>
    <h1>{{ title }}</h1>
    <p class="muted">{{ report_date }} · 生成于 {{ generated_at }}</p>
    <p class="muted">看懂值得关注的科技变化，发现可用的方法，理解机会与瓶颈。</p>
    {% if preview_notice|default('') %}<p>{{ preview_notice }}</p>{% endif %}
  </header>

  {% if plain_digest and plain_digest.has_content %}
  <section class="section digest">
    <h2>今日速读</h2>
    <div class="digest-block">
      <p class="muted">每条先看一件事，点击可查看原文。</p>
      <div class="scan-list">{% for item in plain_digest.tech_items %}<div class="scan-item">{% if item.kicker %}<span class="scan-kicker">{{ item.kicker }}</span>{% endif %}{% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.scan }}</a>{% else %}<span>{{ item.scan }}</span>{% endif %}</div>{% endfor %}</div>
    </div>
  </section>
  {% endif %}

  <nav class="report-tabs" role="tablist" aria-label="日报内容">
    <button id="intensive-tab" type="button" role="tab" aria-selected="true" aria-controls="intensive-panel" data-tab="intensive">详细解读</button>
    <button id="extensive-tab" type="button" role="tab" aria-selected="false" aria-controls="extensive-panel" data-tab="extensive" tabindex="-1">更多线索</button>
    <button id="git-tab" type="button" role="tab" aria-selected="false" aria-controls="git-panel" data-tab="git" tabindex="-1">开源工具</button>
  </nav>

  <section id="intensive-panel" class="tab-panel" role="tabpanel" aria-labelledby="intensive-tab">
    <section class="section">
      <h2>详细解读 <span class="muted" style="font-size:13px;font-weight:400">{{ intensive_analyses|length }} 项 · 核验情况与来源限制见各条说明</span></h2>
      <p class="muted section-intro">先了解这件事为什么值得读，再按需展开数据与技术细节。</p>
    </section>

    {% macro story_card(analysis, item, lane_label, index) %}
    {% set verification = analysis|verification_status %}
    <article class="story" id="story-{{ analysis.event_id }}">
      <div class="story-kicker">
        <span>{{ lane_label }} {{ '%02d'|format(index) }}</span>
        <span class="badge {{ 'lead' if verification.state != 'verified' else '' }}">{{ verification.label }}</span>
      </div>
      <h3 class="story-title">{% if analysis.evidence %}<a href="{{ analysis.evidence[0].url }}" target="_blank" rel="noopener noreferrer">{{ analysis|display_headline }}</a>{% else %}{{ analysis|display_headline }}{% endif %}</h3>
      <p class="muted quality-line">{{ verification.source }}{% if analysis.publication.freshness_label %} · {{ analysis.publication.freshness_label }}{% endif %}</p>
      <div class="reader-label">发生了什么，为什么值得关注</div>
      {% if item.takeaway_paragraphs %}<div class="reader-summary">{% for paragraph in item.takeaway_paragraphs %}<p>{{ paragraph }}</p>{% endfor %}</div>{% else %}<p class="takeaway">这条材料暂缺可靠的中文解读，请查看下方原文与核验限制。</p>{% endif %}
      <div class="story-actions">
        {% if analysis.evidence %}<a class="source-link" href="{{ analysis.evidence[0].url }}" target="_blank" rel="noopener noreferrer">阅读原文 ↗</a><span class="muted">{{ analysis.evidence[0].locator }} · 共 {{ analysis.evidence|length }} 条证据</span>{% else %}<span class="muted">本条暂无可定位原文</span>{% endif %}
      </div>
      <details class="deep-dive">
        <summary>查看关键数据、技术细节与核验记录</summary>
        <div class="deep-body">
          {{ reader_facts(item) }}
          <p class="muted">{{ verification.detail }}</p>
          <p class="muted quality-line">{{ item.date_line }} · 原文摘录 {{ analysis.quality.supported_evidence }} · 来源 {{ analysis.quality.source_diversity }}（一手 {{ analysis.quality.primary_sources }}）</p>
          {% if analysis.publication.source_updated_at %}<p class="muted">更新日期不代表首次发布。</p>{% endif %}
          {% if analysis.publication.unverified_placeholder %}{% if analysis.publication.source_headline %}<p class="muted">原文题名：{{ analysis.publication.source_headline }}</p>{% endif %}{% for excerpt in analysis.publication.source_excerpts %}<p class="evidence">原文摘录（待核验）：{{ excerpt }}</p>{% endfor %}{% endif %}
          {% if analysis.quality.issues %}<div class="quality-alert"><strong>阅读时需注意：</strong>{% for issue in analysis.quality.issues %}{{ issue|quality_issue }}{% if not loop.last %}、{% endif %}{% endfor %}</div>{% endif %}
          {{ audit_details(analysis|audit_notes) }}
          {% if analysis.technical_mechanism or analysis.novelty or analysis.maturity or analysis.outlook_6_24m %}<div class="analysis-grid">
            {% if analysis.technical_mechanism %}<div><strong>具体怎么做</strong><p>{{ analysis.technical_mechanism }}</p></div>{% endif %}
            {% if analysis.novelty %}<div><strong>这次有什么变化</strong><p>{{ analysis.novelty }}</p></div>{% endif %}
            {% if analysis.outlook_6_24m %}<div><strong>6–24个月影响</strong><p>{{ analysis.outlook_6_24m }}</p></div>{% endif %}
          </div>{% endif %}
          {% if analysis.industry_impacts %}<div class="subhead">产业链影响</div><ul>{% for item in analysis.industry_impacts %}<li><strong>{{ item.segment }}</strong> · {{ item.horizon }} · {{ item.direction }}：{{ item.rationale }}</li>{% endfor %}</ul>{% endif %}
          {% if analysis.evidence %}<div class="subhead">可定位证据</div>{% for item in analysis.evidence %}<div class="evidence"><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.locator }} ↗</a>：{{ item.quote }}</div>{% endfor %}{% endif %}
        </div>
      </details>
    </article>
    {% endmacro %}
    {% macro reader_facts(item) %}
      <div class="reader-facts">
        {% if item.key_facts %}<div class="reader-label">具体结果与条件</div><ul class="highlights">{% for fact in item.key_facts %}<li>{{ fact }}</li>{% endfor %}</ul>{% endif %}
        {% if item.maturity %}<div class="reader-label">目前做到哪一步</div><p>{{ item.maturity }}</p>{% endif %}
        {% if item.risks or item.counterpoints %}<div class="reader-label">限制与反面信息</div><ul>{% for value in item.risks + item.counterpoints %}<li>{{ value|reader_notice }}</li>{% endfor %}</ul>{% endif %}
        <p class="muted quality-line">{{ item.verification.detail }}</p>
      </div>
    {% endmacro %}
    {% macro audit_details(notes) %}
      {% if notes %}<details class="quality-alert"><summary>核验说明：{{ notes|length }} 项草稿表述未采用</summary>
        <p>以下是被剔除的草稿内容，不作为本报结论。</p>
        {% for note in notes %}<div><strong>{{ note.field }}</strong><p>未采用表述：{{ note.text }}</p><p>原因：{{ note.reason }}</p></div>{% endfor %}
      </details>{% endif %}
    {% endmacro %}
    {% if intensive_analyses %}
    {% for analysis in intensive_analyses %}{{ story_card(analysis, plain_digest.tech_items[loop.index0], '解读', loop.index) }}{% endfor %}
    {% else %}
    <section class="section"><p class="muted">今日暂无详细解读，可在“更多线索”中浏览初步整理的内容。</p></section>
    {% endif %}

    <details class="section runtime">
      <summary>运行、模型与来源状态</summary>
      <p class="muted">实验 {{ experiment_id|default('default') }} · 运行 {{ run_name|default('default') }} · 行情交易日 {{ market_date }}{% if not is_trading_day %} · 非交易日，行情沿用最近交易日{% endif %}</p>
      <p class="muted">AI：{{ "已启用" if ai_status == "enabled" else "本次未启用或不可用" }}；实际提供方 {{ model_runtime.provider|default('unknown') }}{% if model_runtime.models %}；本次实际模型 {% for stage, model in model_runtime.models.items() %}{{ stage }}={{ model }}{% if not loop.last %}、{% endif %}{% endfor %}{% elif model_runtime.analysis_models %}；缓存分析模型 {{ model_runtime.analysis_models|join('、') }}{% elif model_runtime.configured_models %}；配置模型 {% for stage, model in model_runtime.configured_models.items() %}{{ stage }}={{ model }}{% if not loop.last %}、{% endif %}{% endfor %}{% endif %}；提示词版本 {{ prompt_version }}；本次成功调用 {{ usage.calls }} 次，请求尝试 {{ usage.attempts|default(usage.calls) }} 次，输入 {{ usage.input_tokens }} tokens，输出 {{ usage.output_tokens }} tokens{% if usage.usage_unknown|default(false) %}（部分请求用量未知，已知用量合计）{% elif usage.estimated %}（估算）{% endif %}。</p>
      <p class="muted">本次计划核验 {{ quality_summary.research_targets|default(0) }} 条；未完成核验 {{ quality_summary.research_failed|default(0) }} 条。刊登内容核验、来源限制及分析完整性分别标示；草稿中未采用的表述保留在核验记录中。</p>
      {% if quality_summary.final_content_passed is defined %}<p class="muted">刊登内容已核验 {{ quality_summary.final_content_passed }} 条；缺少一手来源 {{ quality_summary.source_limited|default(0) }} 条；分析栏目未齐全 {{ quality_summary.analysis_incomplete|default(0) }} 条。后两项可与已核验条目重叠。</p>{% endif %}
      <h3>科技来源</h3>{% for item in intelligence_source_status %}<div class="status"><strong>{{ item.name }}</strong><span class="{{ 'stale' if item.stale else '' }}">{{ '失败/缓存' if item.stale else '采集成功' }}</span><span class="muted">{{ item.count|default(0) }} 条{% if item.error %} · {{ item.error }}{% endif %}</span></div>{% endfor %}
      <h3 style="margin-top:16px">AkShare 市场雷达</h3>{% for item in market_source_status %}<div class="status"><strong>{{ item.name }}</strong><span class="{{ 'stale' if item.stale else '' }}">{{ '使用缓存' if item.stale else '实时成功' }}</span><span class="muted">{{ item.source }} · {{ item.fetched_at }}{% if item.error %} · {{ item.error }}{% endif %}</span></div>{% endfor %}
      {% if pipeline_errors %}<h3 style="margin-top:16px">采集与处理异常</h3><ul class="muted">{% for item in pipeline_errors %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
    </details>
  </section>

  <section id="extensive-panel" class="tab-panel" role="tabpanel" aria-labelledby="extensive-tab" hidden>
    <div id="extensive-index">
      <section class="section digest">
        <h2>更多线索 <span class="muted" style="font-size:13px;font-weight:400">{{ extensive_items|length }} 项</span></h2>
        <p class="muted section-intro">按主题浏览，先看一句话介绍，再点开感兴趣的内容。</p>
        {% if extensive_groups %}
        <div class="scan-clusters">{% for group in extensive_groups %}<section class="scan-cluster"><h3><span>{{ group.label }}</span><span class="scan-count">{{ group['items']|length }} 项</span></h3><div class="scan-list">{% for item in group['items'] %}<div class="scan-item"><button type="button" class="extensive-entry" data-extensive-target="{{ item.detail_id }}" aria-controls="{{ item.detail_id }}">{{ item.headline }}</button>{% if item.scan != item.headline %}<p class="scan-context">{{ item.scan }}</p>{% endif %}</div>{% endfor %}</div></section>{% endfor %}</div>
        {% else %}
        <p class="muted">今日没有其他线索。</p>
        {% endif %}
      </section>
    </div>
    {% for item in extensive_items %}
    <section id="{{ item.detail_id }}" class="section extensive-detail" data-extensive-detail hidden aria-labelledby="{{ item.detail_id }}-title">
      <button type="button" class="extensive-back" data-extensive-back>← 返回线索列表</button>
      <div class="story-kicker"><span>{{ item.kicker }} · 线索 {{ '%02d'|format(loop.index) }}</span><span class="badge lead">{{ item.verification.label }}</span></div>
      <h2 id="{{ item.detail_id }}-title" tabindex="-1">{{ item.headline }}</h2>
      <p class="muted extensive-detail-meta">{{ item.verification.source }}{% if item.freshness_label %} · {{ item.freshness_label }}{% endif %}</p>
      <div class="reader-label">一句话了解</div>
      <p class="takeaway">{{ item.scan }}</p>
      {% if item.takeaway != item.scan and item.takeaway_paragraphs %}<div class="reader-label">发生了什么，为什么值得关注</div><div class="reader-summary">{% for paragraph in item.takeaway_paragraphs %}<p>{{ paragraph }}</p>{% endfor %}</div>{% endif %}
      {% if item.url %}<a class="source-link" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">阅读原文 ↗</a>{% endif %}
      <details class="deep-dive"><summary>查看关键数据、技术细节与核验记录</summary><div class="deep-body">
      {{ reader_facts(item) }}
      {% if item.technical_mechanism or item.novelty or item.maturity or item.outlook %}<div class="analysis-grid extensive-detail-block">
        {% if item.technical_mechanism %}<div><strong>具体怎么做</strong><p>{{ item.technical_mechanism }}</p></div>{% endif %}
        {% if item.novelty %}<div><strong>这次有什么变化</strong><p>{{ item.novelty }}</p></div>{% endif %}
        {% if item.outlook %}<div><strong>6–24个月影响</strong><p>{{ item.outlook }}</p></div>{% endif %}
      </div>{% endif %}
      <p class="muted">{{ item.verification.detail }}{% if item.date_line %} · {{ item.date_line }}{% endif %}</p>
      {{ audit_details(item.audit_notes) }}
      {% if item.unverified_placeholder %}{% if item.source_headline %}<p class="muted">原文题名：{{ item.source_headline }}</p>{% endif %}{% for excerpt in item.source_excerpts %}<p class="evidence">原文摘录（待核验）：{{ excerpt }}</p>{% endfor %}{% endif %}
      {% if item.sources %}<div class="extensive-detail-block"><h3>来源材料</h3>{% for source in item.sources %}<div class="evidence">{% if source.url %}<a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.locator or '阅读原文' }} ↗</a>{% else %}<strong>{{ source.locator or '来源摘录' }}</strong>{% endif %}{% if source.quote %}：{{ source.quote }}{% endif %}</div>{% endfor %}</div>{% endif %}
      </div></details>
    </section>
    {% endfor %}
  </section>

  <section id="git-panel" class="tab-panel" role="tabpanel" aria-labelledby="git-tab" hidden>
    <section class="section">
      <h2>Git 热门项目 <span class="muted" style="font-size:13px;font-weight:400">{{ github_projects|default([])|length }} 项</span></h2>
      <p class="muted section-intro">GitHub 今日最热和本周增长最快的仓库。{% if github_brief_status == 'generated' %}AI 已逐仓库对照 README、清单文件与源码入口，说明项目功能和具体使用场景。{% elif github_brief_status == 'reused' %}沿用同一批材料已有的项目功能与使用场景解读，本次未重新采集或核验。{% elif github_brief_status == 'partial' %}AI 已完成部分仓库解读；材料不足或解读缺失的项目保留原始简介。{% elif github_brief_status == 'failed' %}本次 AI 解读失败，以下暂用仓库原始简介。{% else %}本次未调用 AI 解读，以下暂用仓库原始简介。{% endif %}同时标明当前总星标。</p>
    </section>
    {% if github_projects|default([]) %}
      {% for item in github_projects %}
      <article class="story">
        <div class="story-kicker">
          <span>{{ item.origin_label or 'Git' }} {{ '%02d'|format(item.rank|default(loop.index)) }}</span>
          <span class="badge">{{ item.reason or '热门' }}</span>
        </div>
        <h3 class="story-title">{% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.full_name }}</a>{% else %}{{ item.full_name }}{% endif %}</h3>
        <p class="muted quality-line">{% if item.kicker %}<span class="scan-kicker">{{ item.kicker }}</span> {% endif %}{% if item.stars_total_label %}<strong>共 {{ item.stars_total_label }} 星</strong>{% endif %}{% if item.language %} · {{ item.language }}{% endif %}{% if item.stars_today %} · 今日 +{{ item.stars_today }}{% endif %}{% if item.stars_week %} · 本周 +{{ item.stars_week }}{% endif %}</p>
        {% if item.plain %}<p class="takeaway">{{ item.plain }}</p>{% endif %}
        {% if item.use_cases %}<div class="subhead">具体使用场景</div><ul>{% for use_case in item.use_cases %}<li>{{ use_case }}</li>{% endfor %}</ul>{% endif %}
        <div class="story-actions">
          {% if item.url %}<a class="source-link" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">打开仓库 ↗</a><span class="muted">GitHub</span>{% else %}<span class="muted">本条暂无链接</span>{% endif %}
        </div>
      </article>
      {% endfor %}
    {% else %}
    <section class="section"><p class="muted">今日没有解析到开源热门项目。请检查来源状态，或联网后重试。</p></section>
    {% endif %}
  </section>

  <section class="section source-summary">
    <h2>本报信息源</h2>
    <p class="muted">按正文实际引用链接统计；一条信息可引用多个来源。来源数量不代表独立验证。</p>
    {% if cited_sources %}<ul>{% for source in cited_sources %}<li><a href="{{ source.url }}" target="_blank" rel="noopener noreferrer">{{ source.name }}</a> · {{ source.count }} 条信息</li>{% endfor %}</ul>{% else %}<p>当前没有可定位的正文引用。</p>{% endif %}
    {% if github_projects %}<p>开源工具：GitHub 仓库 README、清单文件与源码材料，共 {{ github_projects|length }} 个项目。</p>{% endif %}
    {% if source_gaps %}<p>采集失败或沿用缓存：{{ source_gaps|join('、') }}。这些缺口可能影响覆盖范围。</p>{% endif %}
    {% if source_coverage_note %}<p>{{ source_coverage_note }}</p>{% endif %}
  </section>
  <footer>免责声明：本报告仅做公开信息整理与研究观察，不构成投资建议。事实请以原始论文、发布说明、公告和交易所披露为准。</footer>
</main>
<script>
  (() => {
    const tabs = Array.from(document.querySelectorAll('.report-tabs [role="tab"]'));
    const panels = {
      intensive: document.getElementById('intensive-panel'),
      extensive: document.getElementById('extensive-panel'),
      git: document.getElementById('git-panel')
    };
    const aliases = {news: 'intensive', market: 'extensive'};
    const extensiveIndex = document.getElementById('extensive-index');
    const extensiveDetails = Array.from(document.querySelectorAll('[data-extensive-detail]'));
    const detailIds = new Set(extensiveDetails.map((detail) => detail.id));
    const showExtensiveDetail = (detailId = '') => {
      const resolved = detailIds.has(detailId) ? detailId : '';
      if (extensiveIndex) extensiveIndex.hidden = Boolean(resolved);
      extensiveDetails.forEach((detail) => { detail.hidden = detail.id !== resolved; });
      return resolved;
    };
    const activate = (route, updateHistory = false, state = null) => {
      const [rawName, requestedDetail = ''] = String(route || '').split('/');
      let name = aliases[rawName] || rawName;
      if (!panels[name]) name = 'intensive';
      const detailId = name === 'extensive' ? showExtensiveDetail(requestedDetail) : showExtensiveDetail();
      tabs.forEach((tab) => {
        const selected = tab.dataset.tab === name;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      Object.entries(panels).forEach(([key, panel]) => { panel.hidden = key !== name; });
      if (updateHistory) {
        const suffix = detailId ? `/${detailId}` : '';
        history.pushState(state, '', `#${name}${suffix}`);
      }
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab.dataset.tab, true));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
        event.preventDefault();
        const delta = event.key === 'ArrowRight' ? 1 : -1;
        const next = tabs[(index + delta + tabs.length) % tabs.length];
        activate(next.dataset.tab, true);
        next.focus();
      });
    });
    document.querySelectorAll('[data-extensive-target]').forEach((button) => {
      button.addEventListener('click', () => {
        const detailId = button.dataset.extensiveTarget;
        activate(`extensive/${detailId}`, true, {fromExtensiveIndex: true});
        document.getElementById(`${detailId}-title`)?.focus();
      });
    });
    document.querySelectorAll('[data-extensive-back]').forEach((button) => {
      button.addEventListener('click', () => {
        if (history.state?.fromExtensiveIndex) {
          history.back();
        } else {
          activate('extensive', true);
        }
      });
    });
    window.addEventListener('popstate', () => activate(location.hash.slice(1), false));
    activate(location.hash.slice(1) || '{{ "intensive" if intensive_analyses else "extensive" }}', false);
  })();
</script>
</body>
</html>
